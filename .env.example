# Provider: "local" (Ollama) or "remote" (OpenRouter) — no automatic fallback between them.
LLM_PROVIDER=remote

# --- Remote (OpenRouter) when LLM_PROVIDER=remote ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SEC=120

# --- Local (Ollama) when LLM_PROVIDER=local ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_SEC=300

# Review scope limits
REVIEW_MAX_FILE_BYTES=500000
REVIEW_MAX_CHUNK_LINES=400
# REVIEW_TEMPERATURE=0.2
# REVIEW_MAX_TOKENS=4096
# REVIEW_LLM_TIMEOUT_SEC=120